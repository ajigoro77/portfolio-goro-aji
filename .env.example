# ============================================
# Environment variables for Portfolio Goro Aji
# ============================================
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.

# Wajib untuk AI chat (dapatkan gratis di https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model utama Groq (opsional, default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Model fallback jika model utama gagal (pisahkan dengan koma)
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,llama-3.1-8b-instant,llama-3.1-8b

# Domain kustom untuk SEO / sitemap (opsional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
